diff --git a/robothor/engine/tests/test_runtime_effects.py b/robothor/engine/tests/test_runtime_effects.py
index 349df82c501..52bab090e3f 100644
--- a/robothor/engine/tests/test_runtime_effects.py
+++ b/robothor/engine/tests/test_runtime_effects.py
@@ -280,3 +280,19 @@ def test_effect_rows_obey_database_tenant_policy(effect_db):
         cur.execute("SELECT set_config('app.tenant_id',%s,true)", (ctx.tenant_id,))
         cur.execute("SELECT id FROM agent_runtime_effects WHERE id=%s", (record["id"],))
         assert str(cur.fetchone()[0]) == str(record["id"])
+
+
+@pytest.mark.parametrize("field", ["tenant_id", "principal_id"])
+def test_resolution_snapshot_rejects_foreign_scope_before_verification(effect_db, field):
+    from unittest.mock import Mock
+
+    ctx = context()
+    row = begin(ctx)
+    effects.finish(ctx, row["id"], "worker", uncertain=True)
+    saved = effects.read(ctx, row["id"])
+    foreign = replace(ctx, **{field: "foreign"})
+    verifier = Mock(side_effect=AssertionError("Foreign snapshot must not reach verifier"))
+    with pytest.raises(ValueError, match="authorized principal"):
+        effects.resolve_record(foreign, saved, verifier)
+    verifier.assert_not_called()
+    assert effects.read(ctx, row["id"])["state"] == "uncertain"
