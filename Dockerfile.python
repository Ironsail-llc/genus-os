# syntax=docker/dockerfile:1.7
# Shared image for engine, bridge, and orchestrator.
# Each service picks its entrypoint via the chart's container `command:`.
#
# Multi-stage build with BuildKit cache mounts for uv:
#   - `builder` resolves deps into a venv (cached across builds)
#   - `runtime` copies the venv + source into a slim final image
#
# Layer order is lock-first so source-only changes hit the dep cache.

# ─── builder ─────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv via the official slim binary (faster + reproducible than pip install uv).
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /usr/local/bin/

WORKDIR /app

# Lock files first — dep layer caches across source-only changes.
COPY pyproject.toml uv.lock README.md ./

# Resolve into a project-local .venv. Cache uv's package cache across builds.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv "$VIRTUAL_ENV" \
    && uv sync --frozen --no-install-project --extra api --extra federation

# Bridge has its own requirements file. Install into the same venv.
COPY crm/bridge/requirements.txt /tmp/bridge-requirements.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r /tmp/bridge-requirements.txt

# Now copy source and install the project itself (editable not needed in image).
COPY robothor /app/robothor
COPY crm /app/crm
COPY infra/migrations /app/infra/migrations
COPY conftest.py /app/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps .

# ─── runtime ─────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

# Runtime needs libpq for psycopg2, curl for healthchecks.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r app && useradd -r -g app -d /app -s /usr/sbin/nologin app

WORKDIR /app

COPY --from=builder --chown=app:app /opt/venv /opt/venv
COPY --from=builder --chown=app:app /app /app

USER app

# Default entrypoint runs the engine; bridge/orchestrator override via `command:`.
CMD ["python", "-m", "robothor.engine.daemon"]
