# ============================================================================
# Genus OS Configuration — docker-compose / container install
# ============================================================================
# This is the template for the compose stack's .env (infra/setup.sh copies it).
#
# FOR A SYSTEMD INSTALL, THE CANONICAL TEMPLATE IS
#   infra/systemd/robothor.env.example
# and that is what scripts/install-units.sh tells you to copy to
# /etc/robothor/robothor.env. It carries the engine knobs — execution mode,
# thermal thresholds, admission, the guardrail ladder — that this file does
# not. Two example files that drift is how an operator fills in the wrong one,
# so add engine knobs THERE, not here.
#
# All values shown are defaults unless marked (required).
# ============================================================================

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────
ROBOTHOR_DB_HOST=127.0.0.1
ROBOTHOR_DB_PORT=5432
ROBOTHOR_DB_NAME=robothor_memory
ROBOTHOR_DB_USER=robothor
ROBOTHOR_DB_PASSWORD=changeme                    # (required) Set a strong password
# Local PostgreSQL commonly uses prefer; remote production databases should
# use verify-full and a trusted CA bundle.
ROBOTHOR_DB_SSLMODE=prefer

# ── Redis ───────────────────────────────────────────────────────────────────
ROBOTHOR_REDIS_HOST=127.0.0.1
ROBOTHOR_REDIS_PORT=6379
ROBOTHOR_REDIS_MAXMEMORY=2gb

# ── Ollama (LLM inference) ─────────────────────────────────────────────────
ROBOTHOR_OLLAMA_HOST=http://127.0.0.1
ROBOTHOR_OLLAMA_PORT=11434

# Embedding model (1024-dim vectors for pgvector)
ROBOTHOR_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Reranker model (cross-encoder for search result reranking)
ROBOTHOR_RERANKER_MODEL=Qwen3-Reranker-0.6B:F16
# Generation model (loaded on demand for RAG responses)
ROBOTHOR_GENERATION_MODEL=qwen3:8b

# ── Service Ports ───────────────────────────────────────────────────────────
ROBOTHOR_API_PORT=9099                           # RAG Orchestrator / API server
ROBOTHOR_BRIDGE_PORT=9100                        # Bridge service (CRM, contacts)
ROBOTHOR_VISION_PORT=8600                        # Vision service (YOLO + faces)

# ── Vision ──────────────────────────────────────────────────────────────────
# Default mode on startup: disarmed, basic, or armed
ROBOTHOR_VISION_MODE=disarmed
# Camera source (device path, RTSP URL, or video file)
ROBOTHOR_CAMERA_SOURCE=/dev/video0
# Resolution
ROBOTHOR_CAMERA_WIDTH=640
ROBOTHOR_CAMERA_HEIGHT=480
# YOLO model variant (nano=6MB, small=22MB, medium=52MB)
ROBOTHOR_YOLO_MODEL=yolov8n
# Vision scene analysis model (optional, requires Ollama)
ROBOTHOR_VLM_MODEL=llama3.2-vision:11b

# ── Workspace ───────────────────────────────────────────────────────────────
# Base directory for runtime data (logs, memory files, face database)
ROBOTHOR_WORKSPACE=/var/lib/robothor
# Log directory
ROBOTHOR_LOG_DIR=/var/log/robothor

# ── Memory System ──────────────────────────────────────────────────────────
# Short-term memory TTL in hours (auto-expires)
ROBOTHOR_MEMORY_TTL_HOURS=48
# Fact importance threshold for long-term storage (0.0 - 1.0)
ROBOTHOR_IMPORTANCE_THRESHOLD=0.3
# Maximum memory blocks content size in characters
ROBOTHOR_MEMORY_BLOCK_MAX_CHARS=5000

# ── Notifications (optional) ───────────────────────────────────────────────
# Telegram bot token for alerts (vision, escalations)
# ROBOTHOR_TELEGRAM_BOT_TOKEN=
# Telegram chat ID for notifications
# ROBOTHOR_TELEGRAM_CHAT_ID=

# ── Voice (Kokoro TTS) ────────────────────────────────────────────────────
ROBOTHOR_TTS_PORT=8880
ROBOTHOR_TTS_VOICE=am_michael

# ── Monitoring (Uptime Kuma) ──────────────────────────────────────────────
ROBOTHOR_MONITORING_PORT=3010

# ── Tunnel ────────────────────────────────────────────────────────────────
# Provider: none, cloudflare, caddy
ROBOTHOR_TUNNEL_PROVIDER=none
# ROBOTHOR_DOMAIN=example.com
# CLOUDFLARE_TUNNEL_TOKEN=

# ── Media (MediaMTX webcam) ───────────────────────────────────────────────
ROBOTHOR_CAMERA_RTSP_PORT=8554
ROBOTHOR_CAMERA_HLS_PORT=8890

# ── Authentication / SSO (fail-closed by default) ──────────────────────────
# Multi-user auth: the dashboard logs users in via enterprise SSO (OIDC), then
# exchanges the verified identity for bridge-issued JWTs. RBAC reuses the
# existing role_permissions policy. Setting GENUS_AUTH_ENFORCE=false does not
# disable authentication. For loopback-only development, explicitly set
# GENUS_INSECURE_DEV_MODE=true; this is rejected in production or on a
# non-loopback bridge bind.
GENUS_AUTH_ENFORCE=true
# GENUS_ENVIRONMENT=production
# Bridge JWT signing key (minimum 32 bytes; required for stable multi-replica
# token verification and rotation).
# GENUS_AUTH_SIGNING_KEY=
# Shared secret authenticating the dashboard → bridge /api/auth/sso exchange.
# (required to enable SSO) Must match the dashboard's value below.
# GENUS_BRIDGE_SSO_SECRET=
# GENUS_OIDC_ISSUERS=https://idp.example.com

# ── Local email + password sign-in ─────────────────────────────────────────
# Day one there is no identity provider, and a five-minute install cannot wait
# for one. Exactly "true" turns on the /signin email+password form and the
# bridge's /api/auth/login: argon2id hashing, one generic failure message, a
# 15-minute freeze after ten failures, and 5 attempts per (email, IP) per
# minute. Set BOTH the bridge and the dashboard copies — the bridge serves the
# route, the dashboard registers the provider that calls it.
#
# When this is the ONLY configured method, the owner account MUST enrol a
# second factor; the Helm shows an undismissable banner until it does.
# Set a password first:  genus user set-password you@example.com
# GENUS_LOCAL_LOGIN=true
#
# Peers allowed to speak for a client address via X-Client-IP. Loopback is
# always trusted, so leave this empty when the dashboard and the bridge share
# a host. Set it when they do not: the dashboard calls the bridge SERVER-side,
# so without a forwarded address the per-IP sign-in limiter sees one address
# for the whole internet.
# GENUS_TRUSTED_PROXIES=10.42.0.0/16,10.43.1.7

# The Helm's PUBLIC origin — the scheme+host a browser actually uses, e.g.
# https://helm.example.com. Without it, sign-in redirects fall back to the
# request origin, which in a Next standalone server is the BIND address
# (server.js uses HOSTNAME || 0.0.0.0), so a successful Cloudflare Access
# login lands the operator on "0.0.0.0 refused to connect" (2026-09-11).
# AUTH_URL=https://helm.example.com

# Dashboard SSO (OIDC) — consumed by the Next.js app (Auth.js v5).
# AUTH_OIDC_ISSUER=https://idp.example.com           # IdP discovery URL
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_NAME=SSO                                  # Button label on /signin
# AUTH_SECRET=                                        # (required) Auth.js cookie/JWT secret
# GENUS_BRIDGE_SSO_SECRET=                            # Must match the bridge value above
# GENUS_LOCAL_LOGIN=true                              # Must match the bridge value above

# Dashboard sign-in via Cloudflare Access (alternative/addition to OIDC above).
# When the dashboard sits behind a Cloudflare Access policy, set both values
# and the app verifies the edge-injected Cf-Access-Jwt-Assertion (JWKS
# signature + issuer + audience) and signs the operator in silently — one
# authentication at the edge, no second IdP prompt. Add the team domain to
# GENUS_OIDC_ISSUERS so the bridge accepts it.
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=                                      # Access application AUD tag(s), comma-separated

# Seed the operator (~/.robothor/owner.yaml) as the tenant 'owner' account
# before enabling enforcement:  robothor auth bootstrap

# ── Docker Compose Profiles ──────────────────────────────────────────────
# Comma-separated: monitoring, tts, media, tunnel, full
COMPOSE_PROFILES=

# Persist each assistant turn onto its agent_run_steps row so a finished
# run's reasoning chain can be read back (diagnosis, replay). Off by default:
# a turn carries whatever the agent was reasoning about. Capped per turn.
#ROBOTHOR_RECORD_ASSISTANT_TURNS=true

# ── Web search (web_search tool) ────────────────────────────────────────────
# web_search grades its own SearXNG answer and, when SearXNG errors or its
# general engines are blocked from this egress IP, drives the engine's browser
# tool over a real Bing / DuckDuckGo results page instead.
# From a residential or datacenter IP most scraped engines block you, so a
# Brave Search API key is the reliable path: web_search prefers it and falls
# back to the SearXNG → browser chain on any error. No key = provider absent
# (no call, no error).
# BRAVE_SEARCH_API_KEY=
# The implicit fallback drives a headed Chromium on the X display; off/0/false
# disables it (an explicit provider="browser" still runs).
# ROBOTHOR_WEB_SEARCH_BROWSER_FALLBACK=on
