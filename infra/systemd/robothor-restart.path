# Watches for agent restart requests. Two triggers, both agent-writable:
#
#   /run/robothor/restart-request           the original #205 single file,
#                                           meaning "restart the engine"
#   /run/robothor/restart-requests/<unit>   one file per requested unit, where
#                                           the FILENAME is the request
#
# Neither file's CONTENTS are ever read. The handler matches the name against a
# fixed allowlist compiled into a root-owned script; anything else is discarded
# and logged.
[Unit]
Description=Robothor — watch for agent restart requests

[Path]
PathExists=/run/robothor/restart-request
DirectoryNotEmpty=/run/robothor/restart-requests
Unit=robothor-restart.service

[Install]
WantedBy=multi-user.target
