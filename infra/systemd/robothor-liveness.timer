# Drives robothor-liveness.service — see that file for the incident this
# closes. Five minutes is the interval; with the default threshold of 3
# consecutive failures the operator hears about a dead engine within ~15
# minutes, without paging on a single restart blip.
[Unit]
Description=Robothor engine liveness probe every 5 minutes

[Timer]
# OnBootSec so a box that boots straight into a dead engine still gets probed;
# without it the timer only starts counting from its first manual activation.
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=30s
# Persistent= is deliberately absent: a liveness probe missed while the box was
# off carries no information, and a catch-up run at boot would only race the
# engine's own startup.

[Install]
WantedBy=timers.target
