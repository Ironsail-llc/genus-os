# Genus OS RAG orchestrator (uvicorn) — systemd service template.
#
# Rendered by scripts/render-unit.sh (see infra/systemd/README.md):
#   /opt/robothor  -> $ROBOTHOR_WORKSPACE
#   User=robothor  -> $ROBOTHOR_SERVICE_USER
[Unit]
Description=Robothor RAG Orchestrator
After=network.target ollama.service postgresql.service docker.service
Wants=ollama.service postgresql.service
# /run/robothor/secrets.env is a tmpfs file that exists only once
# robothor-secrets.service has decrypted it, and the EnvironmentFile= below is
# optional (`-`) — so without this ordering the orchestrator starts with no
# provider credentials and says nothing. See the 2026-09-03 boot-order
# incident in robothor-bridge.service. (An instance with no SOPS file skips
# the oneshot on a Condition, which satisfies Requires=.)
Requires=robothor-secrets.service
After=robothor-secrets.service

# Loopback, not 0.0.0.0. On 2026-08-27 this bound the wildcard with no
# authentication and was verified reachable from a tailnet address (HTTP
# 200 on /docs, a RAG pipeline with memory search) by 62 peers. Tailscale
# bypasses UFW entirely, so the tailnet ACL was the only control in front
# of it. cloudflared and the vision service both reach it via localhost.
[Service]
Type=simple
User=robothor
Group=robothor
WorkingDirectory=/opt/robothor
# A CONTROL process. systemd judges a killed ExecStartPre by EXIT_CLEAN_COMMAND,
# where SIGTERM is NOT a clean exit (a main process is judged by
# EXIT_CLEAN_DAEMON, where it is). So a second `systemctl restart` of this unit
# arriving while a first one is still in this step kills the script 18 ms in:
# `Control process exited, code=killed, status=15/TERM`, `Failed with result
# 'signal'`, OnFailure= pages — the 2026-09-17 deploy, where `restart
# robothor-secrets` (which propagates through Requires=) was followed 1.65 s
# later by `restart robothor-engine ...`. The fix is ONE restart transaction
# (scripts/install-units.sh --restart; the restart broker coalesces), never
# SuccessExitStatus=SIGTERM: to a control process that means "the step
# SUCCEEDED", and ExecStart would run with secrets.env unwritten
# (tests/test_pager_hardening.py forbids it).
ExecStartPre=/opt/robothor/scripts/load-secrets.sh
EnvironmentFile=-/run/robothor/secrets.env
ExecStart=/opt/robothor/venv/bin/python -m uvicorn robothor.api.orchestrator:app --host 127.0.0.1 --port 9099
Restart=on-failure
RestartSec=5
# KillMode=mixed sends SIGTERM to the MAIN process (uvicorn) directly, then
# SIGKILLs the whole cgroup at TimeoutStopSec. Under the default control-group
# mode every stop timed out: "State 'stop-sigterm' timed out. Killing ...
# uvicorn ... Failed with result timeout" (observed 2026-08-19). uvicorn still
# takes long to drain on SIGTERM — what blocks its graceful shutdown (in-flight
# task or signal propagation through the venv shim) is under investigation;
# once fixed, TimeoutStopSec here can come down.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
