# Genus OS Bridge Service — systemd service template
#
# Glue service providing contact resolution, webhooks, CRM integration,
# and merge operations. Exposes REST API for agent tools.
#
# Installation:
#   1. Copy this file to /etc/systemd/system/robothor-bridge.service
#   2. Edit User= to match your system user
#   3. Ensure /etc/robothor/robothor.env exists (see robothor.env.example)
#   4. Run: sudo systemctl daemon-reload
#   5. Run: sudo systemctl enable --now robothor-bridge
#
# Logs: journalctl -u robothor-bridge -f
# Health: curl http://localhost:9100/health

[Unit]
Description=Genus OS Bridge Service (CRM + Contact Resolution)
Documentation=https://github.com/robothor-ai/robothor
After=network-online.target postgresql.service redis.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
# Set User to the system user that runs Genus OS
User=robothor
Group=robothor
WorkingDirectory=/opt/robothor/crm/bridge

ExecStart=/opt/robothor/crm/bridge/venv/bin/python bridge_service.py

EnvironmentFile=/etc/robothor/robothor.env
# GENUS_BRIDGE_SSO_SECRET and GENUS_OIDC_ISSUERS live in secrets.env, not
# robothor.env. Without this line the bridge process had neither, so
# routers/auth.py:48-52 read GENUS_BRIDGE_SSO_SECRET as None and :105-106
# returned 403 on EVERY /auth/sso exchange. Cloudflare Access authenticated the
# user at the edge, the JWT verified, the bridge refused, proxy.ts:54 saw no
# bridgeAccess and :62-65 bounced them to /signin. Nobody could sign in from
# 2026-07-26 until 2026-08-27.
EnvironmentFile=-/run/robothor/secrets.env
# GENUS_ENVIRONMENT=production is NOT set here yet, deliberately.
# auth/runtime.py:104-112 requires THREE things in production:
# GENUS_AUTH_SIGNING_KEY (>=32 bytes), GENUS_BRIDGE_SSO_SECRET, and
# GENUS_OIDC_ISSUERS. Only the second exists on this box; setting the flag
# without the other two crash-loops the bridge on startup
# ("GENUS_AUTH_SIGNING_KEY is required in production"), which is the check
# working correctly. See the follow-up commit that provisions the signing key.

Restart=always
RestartSec=5
KillMode=control-group

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/log/robothor

LimitNOFILE=65536
TimeoutStartSec=30
TimeoutStopSec=30

# ── Containment ──────────────────────────────────────────────────────────────
# The bridge is the HTTP API. It does not run agent `exec`, but it holds the
# database credentials and serves every tenant's data, so the same escalation
# logic applies: nothing it runs should ever be able to gain privileges.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
# /opt/robothor = workspace placeholder, /home/robothor = service-user home
# placeholder (rendered by scripts/render-unit.sh). Never %h: in a system unit
# %h is /root — a past incident. NOTE: the live bridge unit is known-divergent
# from this template; adoption of the live deltas is tracked separately (R7).
ReadWritePaths=/opt/robothor
ReadWritePaths=/home/robothor/.config/robothor
ReadWritePaths=/run/robothor
ReadWritePaths=/var/run/postgresql
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
