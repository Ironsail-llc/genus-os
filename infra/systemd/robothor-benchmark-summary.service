# NOTE: paths/user below use the generic /opt/robothor + robothor-user
# convention. On install, adjust to your instance workspace and user
# (this box: /home/<user>/robothor). See templates/ for onboarding.
[Unit]
Description=Robothor — daily benchmark summary (Telegram)
After=postgresql.service robothor-engine.service

[Service]
Type=oneshot
User=robothor
Group=robothor
EnvironmentFile=/etc/robothor/robothor.env
EnvironmentFile=-/run/robothor/secrets.env
Environment=ROBOTHOR_TENANT_ID=robothor-primary
Environment=HOME=/opt/robothor
TimeoutStartSec=120
WorkingDirectory=/opt/robothor
ExecStart=/opt/robothor/venv/bin/python /opt/robothor/scripts/daily_benchmark_summary.py
