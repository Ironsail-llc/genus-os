[Unit]
Description=Robothor — daily benchmark summary (Telegram)
After=postgresql.service robothor-engine.service

[Service]
Type=oneshot
User=robothor
Group=robothor
EnvironmentFile=/etc/robothor/robothor.env
EnvironmentFile=-/run/robothor/secrets.env
Environment=ROBOTHOR_TENANT_ID=robothor-primary
TimeoutStartSec=120
WorkingDirectory=${ROBOTHOR_WORKSPACE}
ExecStart=${ROBOTHOR_WORKSPACE}/venv/bin/python ${ROBOTHOR_WORKSPACE}/scripts/daily_benchmark_summary.py
