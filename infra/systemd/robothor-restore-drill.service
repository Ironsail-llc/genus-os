# Monthly proof that the backups can actually be RESTORED
# (scripts/restore-drill.sh).
#
# robothor-backup-verify.service is not this. It is backup-offsite.sh with
# ROBOTHOR_OFFSITE_VERIFY_ONLY=1 — an rclone byte-comparison of the local dumps
# against the remote. That proves the bytes match; it proves nothing about
# whether they reconstitute a database. A dump truncated at source is
# byte-identical offsite and restores into nothing.
#
# docs/runbooks/RESTORE_DRILL.md is the procedure that answers the real
# question, and it had been run by hand twice in five months. This unit runs it
# monthly: fetch the newest dump (offsite first — that is the path a box loss
# actually takes), restore it into a scratch database, time it, count what came
# back, and drop the scratch database. The result is written as an info
# notification for main's heartbeat.
#
# Enable with: sudo systemctl enable --now robothor-restore-drill.timer
#
# Template — instance values use the canonical placeholder spellings
# (see infra/systemd/README.md) and are substituted by scripts/render-unit.sh
# at install time.
[Unit]
Description=Robothor — monthly database restore drill
After=postgresql.service network-online.target
Wants=postgresql.service network-online.target
#
# Deliberately no RequiresMountsFor= and no ExecCondition= on the backup
# volume: the drill prefers the OFFSITE copy and falls back to the local one,
# so a wedged local volume is something it should discover and report, not a
# reason for systemd to skip it. "No restorable copy" is the drill's most
# important possible finding.
OnFailure=robothor-alert@%n.service

[Service]
Type=oneshot
User=robothor
WorkingDirectory=/opt/robothor
EnvironmentFile=/etc/robothor/robothor.env
EnvironmentFile=-/run/robothor/secrets.env
ExecStart=/usr/bin/bash /opt/robothor/scripts/restore-drill.sh
# The measured baselines are 9m01s and 6m00s on a 1.1-1.3 GB dump, plus the
# rclone fetch. systemd's default TimeoutStartSec (90s) would SIGTERM the drill
# mid-restore and report a failure that says nothing about the backup — the
# unit would be measuring itself instead of the data.
TimeoutStartSec=7200

# The drill is I/O and CPU heavy and competes with the live database. Yield to
# everything else: a restore drill that degrades production is a restore drill
# that gets disabled.
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
