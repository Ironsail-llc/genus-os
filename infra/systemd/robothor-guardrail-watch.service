# Daily guardrail soak report — would-block ("observed") counts per
# guardrail, run error/timeout rate, and flag-soak-deadline nags, so an
# observe→enforce promotion is data-driven (scripts/guardrail_watch.py).
#
# 2026-08-16: this unit had no repo mirror at all, and the live copy carried
# neither After=postgresql.service nor OnFailure=robothor-alert@%n.service —
# every backup unit carries both. The timer's Persistent=true fired at boot
# before postgres was up; guardrail_watch.py's main() ran its DB-dependent
# section first, so the raised connection error skipped the drift checks
# (drop-in + host-script drift) too — checks that need no database at all.
# The drift watchdog was undetectably down. main() now runs the DB-free
# checks first and reports them even when the DB section fails.
#
# Template — instance values use the canonical placeholder spellings
# (see infra/systemd/README.md) and are substituted by scripts/render-unit.sh
# at install time.
[Unit]
Description=Robothor guardrail soak report
After=postgresql.service
Wants=postgresql.service
OnFailure=robothor-alert@%n.service

[Service]
Type=oneshot
User=robothor
WorkingDirectory=/opt/robothor
EnvironmentFile=/etc/robothor/robothor.env
# The flag-soak nag goes out over Telegram (guardrail_watch.send_telegram),
# and those credentials live in the tmpfs secrets file, not robothor.env. With
# only the line above, send_telegram() found no token, returned False without
# a word, and the nag reached the journal and nowhere else. `-` so a boot-time
# catch-up before the secrets are decrypted degrades to a journal-only report
# instead of failing the unit. systemd reads this as root before dropping to
# User=robothor, so the 0600 service-user file is still readable.
EnvironmentFile=-/run/robothor/secrets.env
ExecStart=/opt/robothor/venv/bin/python /opt/robothor/scripts/guardrail_watch.py
