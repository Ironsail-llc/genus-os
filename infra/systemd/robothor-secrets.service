# Genus OS secrets decryption — systemd service template.
#
# Rendered by scripts/render-unit.sh (see infra/systemd/README.md):
#   /opt/robothor  -> $ROBOTHOR_WORKSPACE
#   User=robothor  -> $ROBOTHOR_SERVICE_USER
#
# WHY THIS UNIT EXISTS
#   /run/robothor/secrets.env is a tmpfs file that exists only after
#   scripts/decrypt-secrets.sh has run. Six services load it — and every one of
#   them loads it as `EnvironmentFile=-`, i.e. OPTIONALLY, which is correct
#   (an instance may have no SOPS secrets at all) but means a service that
#   starts before the file exists starts WITHOUT its secrets and says nothing.
#
#   Until this unit existed, the only thing that wrote that file at boot was
#   the ENGINE's ExecStartPre. Nothing ordered anyone else after the engine.
#   On 2026-09-03 the box rebooted at 02:51, robothor-bridge started at
#   02:51:12 with no secrets file on disk, and the engine came up hours later.
#   The bridge therefore had no GENUS_BRIDGE_SSO_SECRET and answered every
#   POST /api/auth/sso with 403 — for eight days, until someone tried to sign
#   in and landed back on /signin.
#
#   So the decrypt becomes a first-class ordering point that the consumers
#   declare `Requires=` + `After=` on. `Requires=`, not `Wants=`: a bridge with
#   no shared secret cannot complete a single login, and failing to start is
#   more honest than starting broken.
[Unit]
Description=Genus OS secrets (SOPS -> /run/robothor/secrets.env)
Documentation=file:///opt/robothor/infra/systemd/README.md
# /run is a tmpfs, so this runs on EVERY boot, not once per install.
After=local-fs.target
# An instance with no encrypted secrets file skips this unit rather than
# failing it. That distinction is load-bearing: systemd treats a
# condition-skipped dependency as SATISFIED, so `Requires=` on it does not
# block the consumers — which keeps the `EnvironmentFile=-` optional
# semantics exactly as they were for instances that run without SOPS.
ConditionPathExists=/etc/robothor/secrets.enc.json
# NOTHING RETRIES THIS. A oneshot has no Restart=, and a failure here leaves
# engine, bridge, app and orchestrator in `dependency failed` — a state in
# which their own Restart=always never fires. So the failure has to reach a
# human: decrypt-secrets.sh exits 1 on a missing age key, an unreadable SOPS
# file, or a missing REQUIRED_KEYS name, and each of those is a four-service
# outage that will not heal itself. See the recovery in infra/systemd/README.md.
OnFailure=robothor-alert@%n.service

[Service]
Type=oneshot
# The unit stays "active (exited)" after the script finishes, so consumers can
# order after it and a later `systemctl start` of one of them does not re-run
# the decrypt. Without this the unit is inactive the moment it succeeds and
# every consumer would pull a fresh decrypt.
RemainAfterExit=yes
User=robothor
Group=robothor
WorkingDirectory=/opt/robothor
EnvironmentFile=/etc/robothor/robothor.env
# The same script the engine's ExecStartPre runs, and it is idempotent: the
# consumers keep their own ExecStartPre so that restarting one of them after a
# secret rotation still picks up the new values (RemainAfterExit means this
# unit will not re-run on its own).
ExecStart=/opt/robothor/scripts/decrypt-secrets.sh

# /run/robothor, owned by the service account, created before the script runs
# and never removed by systemd (Preserve=yes — a `systemctl stop` of this unit
# must not delete the directory every other service reads).
#
# 0750, which is what a live box already has. NOT 0755: the directory holds
# more than secrets.env, and not all of it is 0600 — model-breaker-alerts.json
# is 0644 — so a mode that looks like a harmless default would quietly make
# every one of those files world-readable.
RuntimeDirectory=robothor
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# ── Containment ──────────────────────────────────────────────────────────────
# This process holds the age key and the plaintext of every credential the
# instance owns, for the few hundred milliseconds it runs. It executes one
# script, reads two files under /etc/robothor, and writes one file under
# /run/robothor — nothing else.
#
# EVERY directive below is already applied to THIS SCRIPT by
# robothor-engine.service: a unit's [Service] sandboxing covers ExecStartPre
# exactly as it covers ExecStart, and the engine's ExecStartPre has been
# running decrypt-secrets.sh under precisely these settings in production for
# months. Nothing here is new confinement being tried for the first time on a
# unit four services now depend on — that equivalence is asserted by
# tests/test_install_units.py::
# test_secrets_unit_hardening_is_a_subset_of_what_already_runs_the_script, so
# adding a directive the engine does not have will fail the suite.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
